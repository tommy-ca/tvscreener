# .env.example - Environment variables template
# Create your local `.env` like:
#   cp .env.example .env
# `.env` is gitignored.

# Workflow defaults (recommended for Prefect server parity)
# Start a local server with:
#   prefect server start --host 127.0.0.1 --port 4200 --background
# Then runs use the dedicated server (no ephemeral startup) via PREFECT_API_URL.
PREFECT_HOME=.prefect-home
PREFECT_API_URL=http://127.0.0.1:4200/api

# Keep this for first-run ephemeral server migrations (if you *don't* set PREFECT_API_URL)
PREFECT_SERVER_EPHEMERAL_STARTUP_TIMEOUT_SECONDS=180

# Strategy filters
# TVSCREENER_MIN_VOLUME=500000
# TVSCREENER_MAX_ATR=2.0
# TVSCREENER_MIN_MA_RATING=0.5
# TVSCREENER_MIN_CONFLUENCE=1
# TVSCREENER_TREND_THRESHOLD=0.0
# TVSCREENER_MR_THRESHOLD=0.2
# TVSCREENER_MIN_ROC=

# Global defaults
# For the all-universe forex matrix rerun workflow:
TVSCREENER_DEFAULT_UNIVERSE=all
TVSCREENER_DEFAULT_TIMEFRAMES=240,60,15
TVSCREENER_CONTRACT_TYPE=cfd
